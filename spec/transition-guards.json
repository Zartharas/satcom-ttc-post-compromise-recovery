{
  "schema_version": "0.2.0",
  "global_guards": [
    {"id": "G-001", "name": "contact_open", "expression": "link.contact_open == true"},
    {"id": "G-002", "name": "future_epoch_only", "expression": "message.target_epoch > receiver.epoch"},
    {"id": "G-003", "name": "replay_identifier_unused", "expression": "message.message_id not in receiver.replay_cache"},
    {"id": "G-004", "name": "recovery_identifier_consistent", "expression": "pending == null or message.recovery_id == pending.recovery_id"},
    {"id": "G-005", "name": "authority_allowed", "expression": "message.authorized_by in receiver.allowed_recovery_authorities"},
    {"id": "G-006", "name": "not_expired", "expression": "current_contact <= pending.expires_after_contact"},
    {"id": "G-007", "name": "bounded_pending_capacity", "expression": "count(receiver.pending_states) < configured_pending_limit"},
    {"id": "G-008", "name": "candidate_cannot_execute_commands", "expression": "command.key_ref == receiver.active_key_ref and receiver.mode in ['NORMAL','VERIFIED']"},
    {"id": "G-009", "name": "no_compromised_key_after_verification", "expression": "command.key_ref not in receiver.compromised_key_refs"},
    {"id": "G-010", "name": "monotonic_counter", "expression": "message.counter > receiver.monotonic_counter"}
  ],
  "baseline_specific": {
    "B0": [
      {
        "transition": "receive_otar",
        "guards": ["G-001", "G-003"],
        "action": "stage uploaded session key; attacker learns it if the protecting master key is compromised"
      },
      {
        "transition": "activate_uploaded_key",
        "guards": ["G-002", "G-003"],
        "action": "activate uploaded session key and increment epoch"
      }
    ],
    "B1": [
      {
        "transition": "receive_kem_init",
        "guards": ["G-001", "G-002", "G-003", "G-004"],
        "action": "stage transcript-bound candidate; do not activate operational SDLS state"
      },
      {
        "transition": "send_kem_confirm",
        "guards": ["G-001", "G-003", "G-004"],
        "action": "mark initiator cryptographic completion; operational activation depends on the explicit integration policy"
      },
      {
        "transition": "receive_kem_confirm",
        "guards": ["G-001", "G-003", "G-004"],
        "action": "mark responder cryptographic completion"
      },
      {
        "transition": "bilateral_activation",
        "guards": [
          "initiator.crypto_complete_epoch == target_epoch",
          "responder.crypto_complete_epoch == target_epoch"
        ],
        "action": "activate the candidate at both endpoints under the default experimental integration policy"
      },
      {
        "transition": "missing_or_out_of_order_required_material",
        "guards": [],
        "action": "abort or expire the exchange; no protocol-layer reordering or retransmission is assumed"
      },
      {
        "transition": "local_completion_activation_negative_control",
        "guards": ["activation_policy == ACTIVATE_ON_LOCAL_COMPLETION"],
        "action": "allow unilateral activation solely to measure divergence risk; do not attribute this policy to Triple-KEM"
      }
    ],
    "B2": [
      {
        "transition": "send_urke_update",
        "guards": ["G-001", "G-002", "G-003", "G-010"],
        "action": "ground sender derives the new key, evolves sender state, and deletes prior sender state"
      },
      {
        "transition": "receive_urke_update",
        "guards": ["G-001", "G-002", "G-003", "G-010"],
        "action": "spacecraft receiver derives the matching key, evolves receiver state, and deletes prior receiver state"
      },
      {
        "transition": "drop_after_sender_evolution",
        "guards": [],
        "action": "record G_AHEAD and LOCKED because the strict baseline retains no prior sender state or recovery checkpoint"
      },
      {
        "transition": "status_telemetry_loss",
        "guards": [],
        "action": "leave endpoints cryptographically synchronized but mark recovery verification INDETERMINATE"
      },
      {
        "transition": "stale_state_restore",
        "guards": [],
        "action": "restore ground to an older epoch and record S_AHEAD and LOCKED"
      },
      {
        "transition": "replayed_or_nonforward_update",
        "guards": [],
        "action": "reject without state change"
      }
    ]
  }
}
